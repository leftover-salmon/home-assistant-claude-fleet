# Copy to ~/.claude/ha-status.env and chmod 600. NEVER commit the real file.
MQTT_HOST=homeassistant.local
MQTT_PORT=1883
MQTT_USER=claude-mqtt
MQTT_PASS='FILL_ME_IN'

# Must be unique per Mac — it is the "Machine" column on the dashboard.
# Copying another Mac's value makes every session claim to be on one machine,
# and the dashboard looks healthy while telling you nothing.
CLAUDE_HA_MACHINE="SET_ME"

# Minutes a "working" session may be silent before HA calls it stale.
# 20 on always-on machines; 0 on a laptop — a closed lid is not a stuck session.
CLAUDE_HA_STALE_MINUTES=20

# Optional:
# SUMMARY_ENABLED=0        # turn off the LLM "working on" summary
# SUMMARY_THROTTLE=600     # seconds between summaries per session
# REANNOUNCE_AFTER=7200    # seconds of silence before re-announcing discovery

# Assumed context window, used for the Context % column. The transcript records the
# model name but not its limit, and the same name covers the 200k and 1M variants.
# A session seen above its assumed limit latches to 1M on its own; set this only if
# you want the figure right from the first turn.
# CLAUDE_HA_CONTEXT_LIMIT=200000

# RTK (optional, https://github.com/rtk-ai/rtk). Found on its own; set these only
# if its ledger lives somewhere unusual, or you raised Claude Code's output cap.
# RTK_DB="$HOME/Library/Application Support/rtk/history.db"
# BASH_MAX_OUTPUT_LENGTH=30000   # chars Claude Code shows the model per command
# RTK_THROTTLE=600               # seconds between RTK publishes per machine
